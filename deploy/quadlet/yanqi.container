[Unit]
Description=Yanqi
Wants=yanqi-napcat.service
After=yanqi-napcat.service

[Container]
Image=git.bitnp.net/so1ve/yanqi:latest
ContainerName=yanqi
Network=yanqi.network
PublishPort=127.0.0.1:3210:3000
Volume=%h/yanqi/data:/app/data:Z

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
