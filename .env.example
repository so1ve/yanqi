BOT_QQ=123456789
# 可选：QQ 密码的 32 位 MD5，用于 NapCat 自动登录。
NAPCAT_QUICK_PASSWORD_MD5=
GROUP_IDS=123456789,987654321
# 可与机器人交互的额外 QQ 号，逗号分隔；各群群主和群管理员自动拥有权限。
ADMIN_IDS=123456789
ONEBOT_TOKEN=replace-with-a-long-random-token
# 本地运行使用此地址；Compose 会自动改为 ws://napcat:3001。
ONEBOT_URL=ws://127.0.0.1:3001
# 决定处理消息时标记 🐳，包括 @ 和未 @ 的请求；填写 QQ 表情 ID，留空关闭。
ACK_EMOJI_ID=128051
# Compose 也使用这个本地目录保存言栖数据和 NapCat 登录状态。
DATA_DIR=./data
# info 显示任务、AI 调用、工具和发送过程；debug 额外显示参数、返回片段及异常堆栈。
LOG_LEVEL=info
# debug 每段参数、结果或异常最多显示的字符数；需要完整长片段时调大。
LOG_DETAIL_CHARS=4000
# Compose 默认输出彩色日志；需要纯文本时取消下一行注释。
# FORCE_COLOR=0
BOT_PERSONA_FILE=./PERSONA.md

# NapCat 在本地保存文件时使用的用户和组，按需改为自己的 UID/GID。
NAPCAT_UID=1000
NAPCAT_GID=1000

# 每个 AI_*_MODEL 都填 BASE_URL,API_KEY,MODEL，逗号之间不加空格。
# 地址通常以 /v1 结尾。文字服务需支持 OpenAI 兼容的流式响应、工具调用和 JSON 输出。
AI_MODEL=https://your-ai-service.example/v1,replace-with-your-api-key,your-model
# 识别未 @ 的记录相关消息，不主动接闲聊。关闭后仍处理 @、引用和追问后的回答。
AUTO_REPLY=true

# 未 @ 消息的入口决策；llm 使用 AI_MODEL，独立服务可选 openai/vercel/jev/clef。
DECISION_PROVIDER=llm
# openai/vercel 填 SDK baseURL，jev/clef 填完整 POST 地址。示例见 README。
# Clef 地址：https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/run/@cf/cloudflare/clef
DECISION_URL=
# Clef 填 Workers AI API Token 原文，不加 Bearer 前缀。
DECISION_API_KEY=
# Clef 填 clef。
DECISION_MODEL=

# 支持严格结构输出时用 json_schema，否则用 json_object。
AI_RESPONSE_FORMAT=json_object
AI_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=8192
# 用于消息分批和上下文选取的字符预算。
AI_INPUT_CHARS=24000
AI_DAILY_CALL_LIMIT=2000

DETECT_INTERVAL_MS=30000
DETECT_BATCH_SIZE=20
TOPIC_IDLE_MS=600000
TOPIC_REOPEN_MS=86400000
WORK_INTERVAL_MS=1000
MAX_ATTACHMENT_BYTES=52428800
# 图片理解和语音转写也填 BASE_URL,API_KEY,MODEL，可分别使用其他服务。
# 图片服务需支持图片输入，音频服务需支持 /audio/transcriptions；留空时不解析对应附件。
# DeepSeek V4.1 Flash 示例：https://api.deepseek.com/v1,你的DeepSeek密钥,deepseek-flash
AI_VISION_MODEL=
AI_AUDIO_MODEL=
