{
  "name": "yanqi",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "build": "nuxt build",
    "check": "nuxt typecheck && pnpm --filter @yanqi/bot check",
    "dev": "nuxt dev --host 127.0.0.1",
    "lint": "eslint . && prettier --check . '!data/**'",
    "lint:fix": "eslint --fix . && prettier --write . '!data/**'",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@koishijs/core": "catalog:",
    "@vicons/tabler": "catalog:",
    "@yanqi/bot": "workspace:*",
    "dompurify": "catalog:",
    "h3": "catalog:",
    "kysely": "catalog:",
    "marked": "catalog:",
    "naive-ui": "catalog:",
    "nuxt": "catalog:",
    "ofetch": "catalog:",
    "typebox": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@so1ve/eslint-config": "catalog:",
    "@so1ve/prettier-config": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vue-tsc": "catalog:"
  }
}
