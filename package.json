{
  "name": "yanqi",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "bot": "node --env-file-if-exists=.env apps/api/run.mjs packages/bot/src/main.ts",
    "build": "pnpm --filter @yanqi/web build",
    "check": "tsc && pnpm --filter @yanqi/web check",
    "dev": "pnpm --parallel --filter @yanqi/api --filter @yanqi/web dev",
    "lint": "eslint . && prettier --check . '!data/**'",
    "lint:fix": "eslint --fix . && prettier --write . '!data/**'",
    "start": "pnpm --filter @yanqi/api start"
  },
  "devDependencies": {
    "@so1ve/eslint-config": "4.7.0",
    "@so1ve/prettier-config": "4.7.0",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "ws": "8.22.0"
  }
}
